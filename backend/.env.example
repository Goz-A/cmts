# Copy to .env for local development
DATABASE_URL=postgresql://localhost:5432/cmts
JWT_SECRET=change-me-in-production        # REQUIRED when NODE_ENV=production
JWT_EXPIRY=8h
CORS_ORIGIN=http://localhost:5175          # comma-separated allowed frontend origins (blank = allow all, dev only)
CORRELATION_WINDOW_HOURS=72
# DATABASE_SSL=true                         # needed when connecting to Render's external database URL
PORT=4000
